{
  "name": "mcp-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.2"
    },
    "id": "mcp-manager",
    "name": "MCPs",
    "icon": "assets/mcps.svg",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "capabilities": ["files"],
      "filesystem": [
        "~/.config/opencode/opencode.json",
        "~/.config/opencode/opencode.jsonc"
      ]
    }
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
